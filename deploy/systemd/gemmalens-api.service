[Unit]
Description=GemmaLens isolated mock API
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/.local/share/gemmalens/current/backend
Environment=APP_DEMO_MODE=true
Environment=MODEL_PROVIDER=mock
Environment=MODEL_SWITCHING_ENABLED=false
Environment=LOCAL_MEDIA_LIBRARY_ENABLED=false
Environment=DATABASE_URL=sqlite:///%h/.local/state/gemmalens/gemmalens.db
Environment=MODEL_RUNTIME_CONFIG_PATH=%h/.local/state/gemmalens/model_runtime.json
Environment=UPLOAD_STORAGE_DIR=%h/.local/state/gemmalens/uploads
Environment=TRANSCRIPT_CACHE_DIR=%h/.local/state/gemmalens/transcript_cache
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=%h/.config/gemmalens/api.env
ExecStart=%h/.local/share/gemmalens/current/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 18012 --workers 1 --timeout-graceful-shutdown 30
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/gemmalens
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=200%
TasksMax=128
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=default.target
